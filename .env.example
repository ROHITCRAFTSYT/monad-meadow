# Environment Variables Template
# Copy this to .env and fill in your own values
# Never commit .env to git!

# Private key for contract deployment (66 chars: 0x + 64 hex digits)
PRIVATE_KEY=0xyourprivatekeyhere

# Mnemonic seed phrase (alternative to PRIVATE_KEY)
# MNEMONIC=word1 word2 word3 ...

# RPC endpoints
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz
MONAD_MAINNET_RPC=https://mainnet-rpc.monad.xyz

# Explorer URLs
MONAD_TESTNET_EXPLORER=https://testnet.monadscan.com
MONAD_MAINNET_EXPLORER=https://monadscan.com
