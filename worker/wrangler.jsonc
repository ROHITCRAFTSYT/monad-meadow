{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monad-meadow",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-15",
  "assets": {
    "directory": "../public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [{ "name": "WORLD_ROOM", "class_name": "WorldRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WorldRoom"] }],
  "vars": {
    "CONTRACT_ADDRESS": "0xe8B6c37f78475024a5d08DB3dF358983a45357A7"
  },
  "observability": { "enabled": true }
}
